###############################################################################
#  Section 4.1:  rgmii_txc Generated Clock
###############################################################################
#
# -name:       the name of the generated clock
# -source:     rgmii_txc is generated by q_rgmii_txc_reg, from clk_100mhz at pin C to pin Q
# -divide_by:  rgmii_txc period / clk_100mhz period
#              40 ns / 10 ns
#              4
# objects:     where the generated clock starts
#

create_generated_clock -name rgmii_txc -source [get_pins q_rgmii_txc_reg/C] -divide_by 4 [get_pins q_rgmii_txc_reg/Q]

###############################################################################
#  Section 4.2:  rgmii_rxc Clock
###############################################################################
#
# -name:    the name of the clock
# -period:  rgmii_rxc period, 40 ns
# objects:  the port the clock enters the device on, from the part
#

create_clock -name rgmii_rxc -period 40.000 [get_ports I_RGMII_RXC]

###############################################################################
#  Section 5.1:  O_RGMII_TXD[3:0]
###############################################################################
#
#                                                                              1     1     1
#                  0_____1     2_____3     4_____5     6_____7     8_____9     0_____1     2
# clk_100mhz     __|     |_____|     |_____|     |_____|     |_____|     |_____|     |_____|
# (100 MHz)
#                                                      |---------->| setup requirement
#                                          |<----------| hold requirement
#
#                  A_______________________B                       C_______________________D
# rgmii_txc      __|                       |_______________________|                       |
# (25 MHz)
#
# setup requirement:  10 ns (launch edge 6 at 30 ns -> capture edge C at 40 ns)
# hold requirement:  -10 ns (launch edge 6 at 30 ns -> capture edge B at 20 ns)
#
#------------------------------------------------------------------------------
#
# -clock:                the capture clock
# -reference_pin:        rgmii_txc is generated at q_rgmii_txc_reg/Q.  Without the reference pin,
#                        the delay from Q to O_RGMII_TXC is left out of the clock path and the timing
#                        report is wrong without any warning.
# -max:                  this is the setup check
# maximum output delay:  rgmii_txd maximum - rgmii_txc minimum + TXD[3:0] setup
#                        0.8 - 2.4 + 1
#                        -0.6 ns
# objects:               which data port the output delay applies to
#

set_output_delay -clock [get_clocks rgmii_txc] -reference_pin [get_ports O_RGMII_TXC] -max -0.600 [get_ports {O_RGMII_TXD[*]}]

#
# -clock_fall:  the same delays for the falling edges of rgmii_txc
# -add_delay:   keeps the delays of the rising edges
#

set_output_delay -clock [get_clocks rgmii_txc] -clock_fall -add_delay -reference_pin [get_ports O_RGMII_TXC] -max -0.600 [get_ports {O_RGMII_TXD[*]}]

#
# -min:                  this is a hold check
# minimum output delay:  rgmii_txd minimum - rgmii_txc maximum - TXD[3:0] hold
#                        0.6 - 2.8 - 1
#                        -3.2 ns
#

set_output_delay -clock [get_clocks rgmii_txc] -reference_pin [get_ports O_RGMII_TXC] -min -3.200 [get_ports {O_RGMII_TXD[*]}]

set_output_delay -clock [get_clocks rgmii_txc] -clock_fall -add_delay -reference_pin [get_ports O_RGMII_TXC] -min -3.200 [get_ports {O_RGMII_TXD[*]}]

#
# multiplier:  (setup requirement - hold requirement) / launch period - 1
#              (10 ns - -10 ns) / 10 ns - 1
#              1
# -hold:       this is the hold multicycle
# -start:      multiplier is relative to the launching clock
# -from:       paths in the design that drive the output port
# -to:         the output data port
#

set_multicycle_path 1 -hold -start -from [get_clocks clk_100mhz] -to [get_ports {O_RGMII_TXD[*]}]

