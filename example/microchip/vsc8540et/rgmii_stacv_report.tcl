###############################################################################

###############################################################################
# Verify Environment Variables Exist
###############################################################################
if {![info exists env(PROJ_DIR)]} {
    error "stacv: environment variable PROJ_DIR is not set"
}

###############################################################################
# Create Report Directories
###############################################################################
# O_RGMII_TXD[3:0], O_RGMII_TX_CTL, I_RGMII_RXD[3:0], I_RGMII_RX_CTL
file mkdir "$env(PROJ_DIR)/example/microchip/vsc8540et/timing_reports"

###############################################################################
# Slow Corner
###############################################################################
config_timing_corners -corner Slow -delay_type min_max
config_timing_corners -corner Fast -delay_type none

# O_RGMII_TXD[3:0]
report_timing -column_style variable_width -to [get_clocks rgmii_txc] -through [get_ports {O_RGMII_TXD[*]}] -setup -max_paths 100 -nworst 100 -path full_clock_expanded -file "$env(PROJ_DIR)/example/microchip/vsc8540et/timing_reports/O_RGMII_TXD_timing.rpt"
report_timing -column_style variable_width -to [get_clocks rgmii_txc] -through [get_ports {O_RGMII_TXD[*]}] -hold -max_paths 100 -nworst 100 -path full_clock_expanded -append -file "$env(PROJ_DIR)/example/microchip/vsc8540et/timing_reports/O_RGMII_TXD_timing.rpt"

