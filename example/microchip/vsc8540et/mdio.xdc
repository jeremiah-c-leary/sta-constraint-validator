# (2.5 MHz)
#
# setup requirement:  200 ns (launch edge 40 at 200 ns -> capture edge C at 400 ns)
# hold requirement:  -200 ns (launch edge 40 at 200 ns -> capture edge A at 0 ns)
#
#------------------------------------------------------------------------------
#
# -clock:                the capture clock
# -reference_pin:        mdc is generated at q_mdc_reg/Q.  Without the reference pin,
#                        the delay from Q to O_MDC is left out of the clock path and the timing
#                        report is wrong without any warning.
# -max:                  this is the setup check
# maximum output delay:  mdio maximum - mdc minimum + MDIO setup
#                        1.5 - 1 + 10
#                        10.5 ns
# objects:               which data port the output delay applies to
#

set_output_delay -clock [get_clocks mdc] -reference_pin [get_ports O_MDC] -max 10.500 [get_ports IO_MDIO]

#
# -min:                  this is a hold check
# minimum output delay:  mdio minimum - mdc maximum - MDIO hold
#                        1 - 1.5 - 14
#                        -14.5 ns
#

set_output_delay -clock [get_clocks mdc] -reference_pin [get_ports O_MDC] -min -14.500 [get_ports IO_MDIO]

#
# multiplier:  setup requirement / launch period
#              200 ns / 10 ns
#              20
# -setup:      this is the setup multicycle
# -start:      multiplier is relative to the launching clock
# -from:       paths in the design that drive the output port
# -to:         the output data port
#

set_multicycle_path 20 -setup -start -from [get_clocks clk_100mhz] -to [get_ports IO_MDIO]

#
# multiplier:  (setup requirement - hold requirement) / launch period - 1
#              (200 ns - -200 ns) / 10 ns - 1
#              39
# -hold:       this is the hold multicycle
#

set_multicycle_path 39 -hold -start -from [get_clocks clk_100mhz] -to [get_ports IO_MDIO]

