###############################################################################
#
# Generated by stacv version 1.0
# Command:    stacv generate report_tcl interface.toml --output if_dac39rf20_stacv_report.xdc
#
#------------------------------------------------------------------------------
#
# Interface:  DAC_SPI
#
# Purpose:    Creates timing reports for ports on interfaces.  These reports
#             can be analyzed by the sta-constraints-validator (stacv).  Each
#             analyzed port on the interface will have setup and hold reports
#             for each corner. Each port will have its own file.
#
# Requires:   PROJ_DIR
#
###############################################################################

###############################################################################
# Verify Environment Variables Exist
###############################################################################
if {![info exists env(PROJ_DIR)]} {
    error "stacv: environment variable PROJ_DIR is not set"
}

###############################################################################
# Verify Report Directories Exist
###############################################################################
# dac_sdi
if {![file isdirectory "$env(PROJ_DIR)/design/build/timing_reports"]} {
    error "stacv: dac_sdi report directory does not exist: $env(PROJ_DIR)/design/build/timing_reports"
}
# dac_scs_n
if {![file isdirectory "$env(PROJ_DIR)/design/build/timing_reports"]} {
    error "stacv: dac_scs_n report directory does not exist: $env(PROJ_DIR)/design/build/timing_reports"
}
# dac_sdo
if {![file isdirectory "$env(PROJ_DIR)/design/build/timing_reports"]} {
    error "stacv: dac_sdo report directory does not exist: $env(PROJ_DIR)/design/build/timing_reports"
}

###############################################################################
# Slow Corner
###############################################################################
config_timing_corners -corner Slow -delay_type min_max
config_timing_corners -corner Fast -delay_type none

# dac_sdi
report_timing -column_style variable_width -to [get_clocks dac_sclk_clk] -through [get_ports dac_sdi] -setup -max_paths 100 -nworst 100 -path full_clock_expanded -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SDO.COPI_timing.rpt"
report_timing -column_style variable_width -to [get_clocks dac_sclk_clk] -through [get_ports dac_sdi] -hold -max_paths 100 -nworst 100 -path full_clock_expanded -append -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SDO.COPI_timing.rpt"

# dac_scs_n
report_timing -column_style variable_width -to [get_clocks dac_sclk_clk] -through [get_ports dac_scs_n] -setup -max_paths 100 -nworst 100 -path full_clock_expanded -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SCS_N.CS_timing.rpt"
report_timing -column_style variable_width -to [get_clocks dac_sclk_clk] -through [get_ports dac_scs_n] -hold -max_paths 100 -nworst 100 -path full_clock_expanded -append -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SCS_N.CS_timing.rpt"

# dac_sdo
report_timing -column_style variable_width -from [get_clocks dac_sclk_clk] -through [get_ports dac_sdo] -setup -max_paths 100 -nworst 100 -path full_clock_expanded -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SDO.CIPO_timing.rpt"
report_timing -column_style variable_width -from [get_clocks dac_sclk_clk] -through [get_ports dac_sdo] -hold -max_paths 100 -nworst 100 -path full_clock_expanded -append -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SDO.CIPO_timing.rpt"

###############################################################################
# Fast Corner
###############################################################################
config_timing_corners -corner Fast -delay_type min_max
config_timing_corners -corner Slow -delay_type none

# dac_sdi
report_timing -column_style variable_width -to [get_clocks dac_sclk_clk] -through [get_ports dac_sdi] -setup -max_paths 100 -nworst 100 -path full_clock_expanded -append -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SDO.COPI_timing.rpt"
report_timing -column_style variable_width -to [get_clocks dac_sclk_clk] -through [get_ports dac_sdi] -hold -max_paths 100 -nworst 100 -path full_clock_expanded -append -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SDO.COPI_timing.rpt"

# dac_scs_n
report_timing -column_style variable_width -to [get_clocks dac_sclk_clk] -through [get_ports dac_scs_n] -setup -max_paths 100 -nworst 100 -path full_clock_expanded -append -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SCS_N.CS_timing.rpt"
report_timing -column_style variable_width -to [get_clocks dac_sclk_clk] -through [get_ports dac_scs_n] -hold -max_paths 100 -nworst 100 -path full_clock_expanded -append -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SCS_N.CS_timing.rpt"

# dac_sdo
report_timing -column_style variable_width -from [get_clocks dac_sclk_clk] -through [get_ports dac_sdo] -setup -max_paths 100 -nworst 100 -path full_clock_expanded -append -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SDO.CIPO_timing.rpt"
report_timing -column_style variable_width -from [get_clocks dac_sclk_clk] -through [get_ports dac_sdo] -hold -max_paths 100 -nworst 100 -path full_clock_expanded -append -file "$env(PROJ_DIR)/design/build/timing_reports/DAC_SDO.CIPO_timing.rpt"

###############################################################################
# Restore Vivado Default
###############################################################################
config_timing_corners -corner Slow -delay_type min_max
config_timing_corners -corner Fast -delay_type min_max
