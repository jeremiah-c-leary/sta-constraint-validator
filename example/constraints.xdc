###############################################################################
#  Section 4.1:  dac_sclk Generated Clock
###############################################################################
#
# -name:       the name of the generated clock
# -source:     dac_sclk is generated by q_spi_output_clock_reg, from clk_100mhz at pin C to pin Q
# -divide_by:  dac_sclk period / clk_100mhz period
#              40 ns / 10 ns
#              4
# objects:     where the generated clock starts
#

create_generated_clock -name dac_sclk -source [get_pins q_spi_output_clock_reg/C] -divide_by 4 [get_pins q_spi_output_clock_reg/Q]

###############################################################################
#  Section 5.1:  O_DAC_DATA
###############################################################################
#
#                                                                              1     1     1     1     1     1     1
#                  0_____1     2_____3     4_____5     6_____7     8_____9     0_____1     2_____3     4_____5     6
# clk_100mhz     __|     |_____|     |_____|     |_____|     |_____|     |_____|     |_____|     |_____|     |_____|
# (100 MHz)
#                                                                  |---setup requirement-->|
#                                          |<---hold requirement---|
#
#                  A_______________________B                       C_______________________D                       E
# dac_sclk       __|                       |_______________________|                       |_______________________|
# (25 MHz)
#
# setup requirement:  20 ns (launch edge 8 at 40 ns -> capture edge D at 60 ns)
# hold requirement:  -20 ns (launch edge 8 at 40 ns -> capture edge B at 20 ns)
#
#------------------------------------------------------------------------------
#
# -clock:                the capture clock
# -clock_fall:           the capture edges D and B are falling edges of dac_sclk
# -reference_pin:        dac_sclk is generated at q_spi_output_clock_reg/Q.  Without the reference pin,
#                        the delay from Q to O_DAC_SCLK is left out of the clock path and the timing
#                        report is wrong without any warning.
# -max:                  this is the setup check
# maximum output delay:  data_output maximum - clock minimum + SDIN setup
#                        3 - 1 + 10
#                        12 ns
# objects:               which data port the output delay applies to
#

set_output_delay -clock [get_clocks dac_sclk] -clock_fall -reference_pin [get_ports O_DAC_SCLK] -max 12.000 [get_ports O_DAC_DATA]

#
# -min:                  this is a hold check
# minimum output delay:  data_output minimum - clock maximum - SDIN hold
#                        1 - 3 - 10
#                        -12 ns
#

set_output_delay -clock [get_clocks dac_sclk] -clock_fall -reference_pin [get_ports O_DAC_SCLK] -min -12.000 [get_ports O_DAC_DATA]

#
# multiplier:  setup requirement / launch period
#              20 ns / 10 ns
#              2
# -setup:      this is the setup multicycle
# -start:      multiplier is relative to the launching clock
# -from:       paths in the design that drive the output port
# -to:         the output data port
#

set_multicycle_path 2 -setup -start -from [get_clocks clk_100mhz] -to [get_ports O_DAC_DATA]

#
# multiplier:  (setup requirement - hold requirement) / launch period - 1
#              (20 ns - -20 ns) / 10 ns - 1
#              3
# -hold:       this is the hold multicycle
#

set_multicycle_path 3 -hold -start -from [get_clocks clk_100mhz] -to [get_ports O_DAC_DATA]

