###############################################################################
#  Section 5.1:  Generated Clock
###############################################################################
#
# -source: dac_sclk is generated by q_spi_output_clock_reg, from clk_100mhz at pin C to pin Q.
# -divide_by:  capture period (40 ns) / launch period (10 ns) = 4

create_generated_clock -name dac_sclk -source [get_pins q_spi_output_clock_reg/C] -divide_by 4 [get_pins q_spi_output_clock_reg/Q]

###############################################################################
#  Section 5.2:  O_DAC_DATA
###############################################################################
#
# -clock_fall:  the capture edges D and B are falling edges of dac_sclk.
# -reference_pin:  dac_sclk is generated at q_spi_output_clock_reg/Q.  Without the reference pin,
#                  the delay from Q to O_DAC_SCLK is left out of the clock path and the timing
#                  report is wrong without any warning.
#
# maximum output delay = data_output maximum - clock minimum + SDIN setup
#                      = 3 - 1 + 10
#                      = 12 ns

set_output_delay -clock [get_clocks dac_sclk] -clock_fall -reference_pin [get_ports O_DAC_SCLK] -max 12.000 [get_ports O_DAC_DATA]

#
# minimum output delay = data_output minimum - clock maximum - SDIN hold
#                      = 1 - 3 - 10
#                      = -12 ns

set_output_delay -clock [get_clocks dac_sclk] -clock_fall -reference_pin [get_ports O_DAC_SCLK] -min -12.000 [get_ports O_DAC_DATA]

# setup:  launch edge 8 (40 ns) -> capture edge D (60 ns), requirement 20 ns
#         multicycle = setup requirement / launch period = 20 ns / 10 ns = 2

set_multicycle_path 2 -setup -start -from [get_clocks clk_100mhz] -to [get_ports O_DAC_DATA]

# hold:   launch edge 8 (40 ns) -> capture edge B (20 ns), requirement -20 ns
#         multicycle = (setup requirement - hold requirement) / launch period - 1
#                    = (20 ns - -20 ns) / 10 ns - 1 = 3

set_multicycle_path 3 -hold -start -from [get_clocks clk_100mhz] -to [get_ports O_DAC_DATA]

